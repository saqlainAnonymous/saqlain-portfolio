# Copy to .env.local and fill in what you need.
# The site runs without these values; the contact and newsletter forms then
# report that they are not connected yet.

# Canonical URL — used by metadata, Open Graph and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Private dashboard at /admin
ADMIN_PASSWORD=
ADMIN_SECRET=
